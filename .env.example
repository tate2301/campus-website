# Book a demo and contact messages go to the Corelith CRM (src/lib/leads.ts), the same intake corelith.co.zw uses.
# Mint a key in the tenant under CRM → Settings → API keys (needs the CRM settings.manage capability). It begins with
# crm_. Leave the key's default channel unset so the CRM derives the channel from the campaign fields.
# Until this is set, submissions are only written to the server log.
CORELITH_CRM_API_KEY=

# Optional: another CRM host, e.g. a staging tenant. Defaults to https://hurudza-creative.apps.corelith.co.zw
CORELITH_CRM_URL=
